[Unit]
Description=KuasaPrestij frontend (production Nitro build on port 3000)
After=network.target kuasaprestij.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/frontend/learn-play-shine-96
EnvironmentFile=/root/frontend/learn-play-shine-96/.env
# Serves the output of `npm run build` (.output/), not `vite dev`: no unbundled JS, ~10 MB -> well under 1 MB
# gzipped on first load. Loopback only; nginx (deploy/nginx-standalone.conf) is the public entry.
# After editing the frontend run deploy/frontend_build.sh (build + restart). VITE_* values are baked in at build time.
Environment=PORT=3000
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/node .output/server/index.mjs
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
