# systemd timer — runs auto_pull.sh every 5 minutes
# Install alongside kuasaprestij-pull.service:
#   sudo cp deploy/kuasaprestij-pull.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kuasaprestij-pull.timer

[Unit]
Description=KuasaPrestij auto-pull timer

[Timer]
OnBootSec=60
OnUnitActiveSec=5min
Unit=kuasaprestij-pull.service

[Install]
WantedBy=timers.target
