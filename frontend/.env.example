# KuasaPrestij frontend — environment template.
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# NOTE: VITE_* vars are read at BUILD time and baked into the bundle — set them
# before `npm run build` (or as Docker build args), not just at runtime.

# Base URL of the FastAPI backend (through nginx in prod).
VITE_API_BASE_URL=https://api.kuasa.tech
# Public URL the app is served from (used for absolute links / redirects).
VITE_APP_URL=https://kuasa.tech

# --- Supabase (client-side; publishable/anon key only, never the service role) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PROJECT_ID=<project-ref>
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-publishable-key>

# Some tooling reads the non-prefixed forms too — keep them in sync.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PROJECT_ID=<project-ref>
SUPABASE_PUBLISHABLE_KEY=<anon-publishable-key>
