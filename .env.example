# KuasaPrestij backend — environment template.
# Copy to `.env` and fill in real values. NEVER commit the real .env (it is gitignored).
# On GCP, prefer storing these in Secret Manager and injecting at deploy time.

# --- Supabase (Postgres + pgvector) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<service-role-or-anon-key>
SUPABASE_ACCESS_TOKEN=<management-api-token>   # only for DDL via the MCP/Management API

# --- LLM chain (see CLAUDE.md for the failover order) ---
CEREBRAS_API_KEY=<cerebras-key>                 # primary — 1M free tokens/day
OPENROUTER_API_KEY=<openrouter-key>             # fallback
GROQ_API_KEY=<groq-key>                         # fallback
DEEPSEEK_API_KEY=<deepseek-key>                 # paid fallback only (omit to skip)

# --- Media ---
PEXELS_API_KEY=<pexels-key>                     # B-Roll video for interactive content
ELEVENLABS_API_KEY=                             # optional TTS provider (currently unused)

# --- Alerts (optional; see agents/telegram_agent.py) ---
TELEGRAM_BOT_TOKEN=                             # admin alerts + daily digest
TELEGRAM_ADMIN_CHAT_ID=                         # your Telegram chat id

# --- Disabled / not in the active stack (kept for reference) ---
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/google-credentials.json  # TTS disabled
# GEMINI_API_KEY=                               # not used in the pipeline
# GEMINI_TEST_API_KEY=                          # test_gemini.py only
# GEMINI_TEST_MODEL=
# LLM_TEST_GEMINI=
# LLAMA_CLOUD_API_KEY=                          # ingestion experiments only
